class InfoWindow:
    """Класс для создания информационного окна, привязанного к объекту"""
    
    def __init__(self, canvas, obj, x, y):
        """Конструктор класса - вызывается при создании окна"""
        self.canvas = canvas              # Сохраняем ссылку на холст для рисования
        self.obj = obj                     # Сохраняем объект (планету/солнце)
        self.x = x                          # Запоминаем координату X окна
        self.y = y                          # Запоминаем координату Y окна
        self.is_visible = True               # Флаг видимости окна
        self.window_id = None                # ID прямоугольника окна на холсте
        self.close_button_id = None          # ID кнопки закрытия
        self.text_items = []                  # Список ID текстовых элементов
        self.image_tk = None                  # Хранилище для изображения (чтобы не удалилось)
        self.image_id = None                   # ID изображения на холсте
        
        self.create_window()                    # Вызываем метод создания окна

    def create_window(self):
        """Создает окно с информацией - все элементы интерфейса"""
        window_x = self.x + 50                   # X позиция окна (справа от объекта)
        window_y = self.y - 120                   # Y позиция окна (выше объекта)
        window_width = 350                         # Ширина окна
        window_height = 420                         # Высота окна
        
        # Создаем прямоугольник-фон окна
        self.window_id = self.canvas.create_rectangle(
            window_x, window_y,                    # Левый верхний угол
            window_x + window_width, window_y + window_height,  # Правый нижний угол
            fill="#2b2b2b", outline="yellow", width=2,  # Темно-серый фон, желтая рамка
            tags="info_window"                      # Тег для группировки элементов
        )
        
        # Создаем заголовок с именем объекта
        self.canvas.create_text(
            window_x + 20, window_y + 25,           # Позиция текста
            text=f"{self.obj.name}",                 # Текст - имя объекта
            fill="yellow", font=("Arial", 16, "bold"),  # Желтый цвет, жирный шрифт
            anchor="w", tags="info_window"            # Выравнивание по левому краю
        )
        
        # Попытка загрузить изображение объекта
        circle_x = window_x + window_width // 2      # Центр по X для изображения
        circle_y = window_y + 85                      # Центр по Y для изображения
        circle_size = 90                               # Размер изображения
        
        # Проверяем различные варианты пути к изображению
        img_path = None
        possible_paths = [                            # Список возможных путей
            f"IMAGES/{self.obj.name.upper()}.jpg",     # В папке IMAGES, заглавными
            # ... другие варианты
        ]
        
        # Ищем существующий файл изображения
        for path in possible_paths:
            if os.path.exists(path):                   # Если файл существует
                img_path = path                         # Сохраняем путь
                break                                    # Прерываем цикл
        
        if img_path and os.path.exists(img_path):       # Если изображение найдено
            try:                                          # Пытаемся загрузить
                pil_image = Image.open(img_path)         # Открываем изображение PIL
                pil_image = pil_image.resize((circle_size, circle_size), Image.Resampling.LANCZOS)  # Изменяем размер
                self.image_tk = ImageTk.PhotoImage(pil_image)  # Конвертируем для tkinter
                
                # Создаем изображение на холсте
                self.image_id = self.canvas.create_image(
                    circle_x, circle_y,                   # Позиция
                    image=self.image_tk, tags="info_window"  # Изображение и тег
                )
                
                # Рисуем рамку вокруг изображения
                self.canvas.create_rectangle(
                    circle_x - circle_size // 2 - 2,      # Левый верхний X
                    circle_y - circle_size // 2 - 2,      # Левый верхний Y
                    circle_x + circle_size // 2 + 2,      # Правый нижний X
                    circle_y + circle_size // 2 + 2,      # Правый нижний Y
                    outline="white", width=2, tags="info_window"  # Белая рамка
                )
            except Exception as e:                         # Если ошибка загрузки
                print(f"Ошибка загрузки изображения {img_path}: {e}")
                self.draw_fallback_circle(circle_x, circle_y, circle_size)  # Рисуем круг-заглушку
        else:                                              # Если изображение не найдено
            self.draw_fallback_circle(circle_x, circle_y, circle_size)  # Рисуем круг-заглушку
        
        # Добавляем описание объекта
        desc_y = circle_y + circle_size // 2 + 25          # Y позиция описания
        desc = OBJECT_DESCRIPTIONS.get(self.obj.name, "Описание отсутствует")  # Получаем описание
        if len(desc) > 180:                                # Если описание слишком длинное
            desc = desc[:180] + "..."                       # Обрезаем и добавляем многоточие
        
        # Создаем текст с описанием
        self.canvas.create_text(
            window_x + 20, desc_y,                         # Позиция
            text=desc,                                      # Текст описания
            fill="white", font=("Arial", 9),                # Белый цвет, маленький шрифт
            anchor="nw", width=310, tags="info_window"      # Выравнивание по левому верхнему краю
        )
        
        # Добавляем характеристики объекта
        specs_y = desc_y + 80                               # Y позиция характеристик
        
        # Разделительная линия
        self.canvas.create_line(
            window_x + 20, specs_y - 10,                    # Начало линии
            window_x + window_width - 20, specs_y - 10,     # Конец линии
            fill="gray", width=1, tags="info_window"        # Серый цвет, тонкая линия
        )
        
        # Формируем список характеристик в зависимости от типа объекта
        if isinstance(self.obj, Sun):                        # Если объект - Солнце
            specs = [                                         # Специфичные для Солнца характеристики
                f"• Радиус: {SUN_DATA['radius']} земных радиусов",
                f"• Температура: 5500°C",
                f"• Возраст: 4.6 млрд лет"
            ]
        elif isinstance(self.obj, Planet):                    # Если объект - планета
            planet_info = next((p for p in PLANET_DATA if p["name"] == self.obj.name), None)  # Ищем данные планеты
            if planet_info:                                    # Если данные найдены
                specs = [                                       # Характеристики планеты
                    f"• Расстояние от Солнца: {planet_info['distance']} а.е.",
                    f"• Радиус: {planet_info['radius']} земных",
                    f"• Период обращения: {planet_info['period']} дней"
                ]
        elif isinstance(self.obj, Moon):                       # Если объект - Луна
            specs = [                                           # Характеристики Луны
                f"• Радиус: {MOON_DATA['radius']} земных",
                f"• Период обращения: {MOON_DATA['period']} дней",
                f"• Расстояние от Земли: 384 400 км"
            ]
        else:                                                   # Если тип не определен
            specs = []                                           # Пустой список характеристик
        
        # Отображаем характеристики
        for i, spec in enumerate(specs):                        # Для каждой характеристики
            self.canvas.create_text(
                window_x + 20, specs_y + i * 22,                 # Позиция (с отступом по Y)
                text=spec,                                        # Текст характеристики
                fill="lightblue", font=("Arial", 9),             # Голубой цвет
                anchor="w", tags="info_window"                    # Выравнивание по левому краю
            )
        
        # Кнопка "Подробнее"
        self.canvas.create_rectangle(
            window_x + 20, window_y + window_height - 45,        # Левый верхний угол
            window_x + 130, window_y + window_height - 20,       # Правый нижний угол
            fill="#4a4a4a", outline="yellow", width=1,           # Серый фон, желтая рамка
            tags=("info_window", "more_btn")                      # Два тега
        )
        
        # Текст на кнопке
        self.canvas.create_text(
            window_x + 75, window_y + window_height - 32,        # Позиция текста
            text="📖 Подробнее",                                   # Текст с эмодзи
            fill="white", font=("Arial", 9),                      # Белый цвет
            tags=("info_window", "more_btn")                       # Два тега
        )
        
        # Привязываем события к кнопке
        self.canvas.tag_bind("more_btn", '<Button-1>',           # Клик левой кнопкой мыши
                             lambda e: self.open_wikipedia())     # Вызов метода открытия Wikipedia
        self.canvas.tag_bind("more_btn", '<Enter>',              # Наведение мыши
                             lambda e: self.on_more_enter())     # Эффект при наведении
        self.canvas.tag_bind("more_btn", '<Leave>',              # Убирание мыши
                             lambda e: self.on_more_leave())     # Убираем эффект
        
        # Кнопка закрытия (крестик)
        self.canvas.create_text(
            window_x + window_width - 20, window_y + 20,         # Позиция в правом верхнем углу
            text="✕", fill="red", font=("Arial", 16, "bold"),    # Красный крестик
            tags=("info_window", "close_btn")                     # Два тега
        )
        
        # Привязываем события к кнопке закрытия
        self.canvas.tag_bind("close_btn", '<Button-1>',          # Клик по крестику
                             lambda e: self.close())              # Вызов метода закрытия
        self.canvas.tag_bind("close_btn", '<Enter>',             # Наведение
                             lambda e: self.canvas.itemconfig("close_btn", fill="yellow"))  # Меняем цвет на желтый
        self.canvas.tag_bind("close_btn", '<Leave>',             # Убирание
                             lambda e: self.canvas.itemconfig("close_btn", fill="red"))     # Возвращаем красный

    def draw_fallback_circle(self, x, y, size):
        """Рисует круг-заглушку, если изображение не найдено"""
        # Рисуем круг
        self.canvas.create_oval(
            x - size // 2, y - size // 2,                        # Левый верхний угол
            x + size // 2, y + size // 2,                        # Правый нижний угол
            fill=self.obj.color, outline="white", width=3,       # Цвет объекта, белая рамка
            tags="info_window"
        )
        
        # Добавляем символ в центр
        if isinstance(self.obj, Sun):                             # Для Солнца
            symbol = "☀️"                                          # Эмодзи солнца
        elif isinstance(self.obj, Moon):                           # Для Луны
            symbol = "🌙"                                          # Эмодзи луны
        elif self.obj.name == "Земля":                             # Для Земли
            symbol = "🌍"                                          # Эмодзи Земли
        elif self.obj.name == "Марс":                              # Для Марса
            symbol = "🔴"                                          # Красный круг
        elif self.obj.name in ["Юпитер", "Сатурн"]:                # Для газовых гигантов
            symbol = "🪐"                                          # Эмодзи планеты с кольцами
        else:                                                      # Для остальных
            symbol = self.obj.name[0]                               # Первая буква названия
        
        # Создаем текст с символом
        self.canvas.create_text(
            x, y,                                                  # Центр круга
            text=symbol,                                           # Символ
            fill="white", font=("Arial", 40),                      # Белый цвет, крупный шрифт
            tags="info_window"
        )

    def on_more_enter(self):
        """Эффект при наведении на кнопку 'Подробнее'"""
        self.canvas.itemconfig("more_btn", fill="yellow")          # Меняем цвет текста на желтый

    def on_more_leave(self):
        """Эффект при убирании мыши с кнопки 'Подробнее'"""
        self.canvas.itemconfig("more_btn", fill="white")           # Возвращаем белый цвет

    def open_wikipedia(self):
        """Открывает страницу Википедии"""
        if self.obj.name in WIKIPEDIA_URLS:                        # Если URL существует
            webbrowser.open(WIKIPEDIA_URLS[self.obj.name])         # Открываем в браузере

    def close(self):
        """Закрывает информационное окно"""
        self.canvas.delete("info_window")                          # Удаляем все элементы с тегом
        self.is_visible = False                                     # Помечаем окно как невидимое

    def update_position(self, x, y):
        """Обновляет позицию окна (если планета движется)"""
        if not self.is_visible:                                     # Если окно не видимо
            return                                                   # Выходим
        
        self.x = x                                                  # Обновляем координаты
        self.y = y
        
        # Получаем текущие координаты окна
        if self.window_id:                                          # Если окно существует
            coords = self.canvas.coords(self.window_id)            # Получаем его координаты
            if coords:                                              # Если координаты получены
                # Вычисляем смещение
                dx = (x + 50) - coords[0]                           # Смещение по X
                dy = (y - 120) - coords[1]                          # Смещение по Y
                
                # Перемещаем все элементы окна
                for item_id in self.canvas.find_withtag("info_window"):  # Для каждого элемента окна
                    self.canvas.move(item_id, dx, dy)                    # Перемещаем
