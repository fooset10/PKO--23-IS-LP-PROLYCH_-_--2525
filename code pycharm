class Planet(SolarObject):
    def __init__(self, canvas, distance_au, data, img_path=None):
        self.distance_au = distance_au                      # Расстояние от Солнца в а.е.
        self.period = data["period"]                        # Период обращения в днях
        self.angle = math.radians(data["angle"])            # Текущий угол в радианах
        self.orbit_radius_base = distance_au * SCALE       # Базовый радиус орбиты в пикселях
        super().__init__(canvas, CENTER_X, CENTER_Y, data["name"],  # Вызов конструктора родителя
                         data["radius"], data["color"], img_path)
        self.initial_angle = data["angle"]                  # Начальный угол для сброса
        # Создаем текстовую метку с названием планеты
        self.label_id = self.canvas.create_text(0, 0, text=data["name"],
                                                fill="white", font=("Arial", 8),
                                                tags=f"label_{data['name']}")

    def update_position(self, time_mult, zoom, dt=0.05):
        """Обновляет позицию планеты в зависимости от времени"""
        # Вычисляем изменение угла: (2π / период) * время * множитель скорости
        delta_angle = (2 * math.pi / self.period) * dt * time_mult
        self.angle += delta_angle                           # Добавляем изменение к текущему углу
        
        # Вычисляем новые координаты
        orbit_r = self.orbit_radius_base * zoom             # Текущий радиус орбиты с учетом масштаба
        x = CENTER_X + orbit_r * math.cos(self.angle)       # X = центр + радиус * cos(угол)
        y = CENTER_Y + orbit_r * math.sin(self.angle)       # Y = центр + радиус * sin(угол)
        
        self.move_to(x, y)                                   # Перемещаем планету
        
        # Обновляем позицию текстовой метки
        self.canvas.coords(self.label_id, x - 15, y - self.radius_px - 5)

    def set_zoom(self, zoom):
        """Изменяет размер планеты при масштабировании"""
        super().set_zoom(zoom)                              # Вызываем метод родителя
