class Moon(SolarObject):
    def __init__(self, canvas, parent_planet, distance_au, data, img_path=None):
        self.parent = parent_planet                         # Родительская планета (Земля)
        self.distance_au = distance_au                      # Расстояние от планеты в а.е.
        self.period = data["period"]                         # Период обращения в днях
        self.angle = math.radians(data["angle"])            # Текущий угол в радианах
        self.base_orbit_radius = distance_au * SCALE       # Базовый радиус орбиты в пикселях
        super().__init__(canvas, parent_planet.x, parent_planet.y, data["name"],  # Вызов конструктора родителя
                         data["radius"], data["color"], img_path)
        # Создаем текстовую метку
        self.label_id = self.canvas.create_text(0, 0, text=data["name"],
                                                fill="white", font=("Arial", 7),
                                                tags=f"label_{data['name']}")

    def update_position(self, time_mult, zoom, dt=0.05):
        """Обновляет позицию Луны относительно Земли"""
        # Вычисляем изменение угла
        delta_angle = (2 * math.pi / self.period) * dt * time_mult
        self.angle += delta_angle                           # Добавляем изменение
        
        # Вычисляем относительные координаты
        orbit_r = self.base_orbit_radius * zoom             # Текущий радиус орбиты
        rel_x = orbit_r * math.cos(self.angle)              # Относительный X
        rel_y = orbit_r * math.sin(self.angle)              # Относительный Y
        
        # Абсолютные координаты = координаты Земли + относительные
        abs_x = self.parent.x + rel_x
        abs_y = self.parent.y + rel_y
        
        self.move_to(abs_x, abs_y)                          # Перемещаем Луну
        
        # Обновляем позицию метки
        self.canvas.coords(self.label_id, abs_x - 10, abs_y - self.radius_px - 3)
