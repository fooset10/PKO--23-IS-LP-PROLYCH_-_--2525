class SolarObject:
    def __init__(self, canvas, x, y, name, radius_earth, color, img_path=None):
        self.canvas = canvas                    # Сохраняем ссылку на холст
        self.name = name                         # Имя объекта
        self.color = color                        # Цвет объекта
        self.base_radius = max(3, radius_earth * 3)  # Базовый радиус в пикселях (минимум 3)
        self.radius_px = self.base_radius          # Текущий радиус (с учетом масштаба)
        self.x = x                                  # Текущая координата X
        self.y = y                                  # Текущая координата Y
        self.info_window = None                     # Информационное окно (пока не создано)
        
        self.image_tk = None                        # Для хранения изображения
        self.image_id = None                         # ID изображения на холсте
        
        # Пытаемся загрузить изображение
        if img_path and os.path.exists(img_path):   # Если путь указан и файл существует
            try:                                     # Пытаемся загрузить
                pil_image = Image.open(img_path)     # Открываем изображение
                img_size = int(self.radius_px * 2)   # Размер изображения (диаметр)
                pil_image = pil_image.resize((img_size, img_size), Image.Resampling.LANCZOS)  # Изменяем размер
                self.image_tk = ImageTk.PhotoImage(pil_image)  # Конвертируем для tkinter
                # Создаем изображение на холсте
                self.image_id = self.canvas.create_image(x, y, image=self.image_tk, anchor='center', tags=self.name)
            except Exception as e:                    # Если ошибка
                print(f"Ошибка загрузки {img_path}: {e}. Рисуем круг.")
                # Рисуем круг вместо изображения
                self.image_id = self.canvas.create_oval(x - self.radius_px, y - self.radius_px,
                                                        x + self.radius_px, y + self.radius_px,
                                                        fill=self.color, outline="white", tags=self.name)
        else:                                         # Если изображение не найдено
            # Рисуем круг
            self.image_id = self.canvas.create_oval(x - self.radius_px, y - self.radius_px,
                                                    x + self.radius_px, y + self.radius_px,
                                                    fill=self.color, outline="white", tags=self.name)

    def set_zoom(self, zoom):
        """Изменяет размер объекта при масштабировании"""
        self.radius_px = max(2, self.base_radius * zoom)  # Новый радиус с учетом масштаба
        if not self.image_tk:                             # Если используется круг (не изображение)
            # Обновляем координаты круга
            x1 = self.x - self.radius_px
            y1 = self.y - self.radius_px
            x2 = self.x + self.radius_px
            y2 = self.y + self.radius_px
            self.canvas.coords(self.image_id, x1, y1, x2, y2)

    def move_to(self, x, y):
        """Перемещает объект в новые координаты"""
        self.x = x                                          # Обновляем координаты
        self.y = y
        if self.image_tk:                                   # Если используется изображение
            self.canvas.coords(self.image_id, x, y)        # Перемещаем центр изображения
        else:                                               # Если используется круг
            # Перемещаем круг (обновляем координаты прямоугольника)
            self.canvas.coords(self.image_id, x - self.radius_px, y - self.radius_px,
                               x + self.radius_px, y + self.radius_px)
        
        # Если есть информационное окно и оно видимо
        if self.info_window and self.info_window.is_visible:
            self.info_window.update_position(x, y)          # Обновляем его позицию

    def show_info(self):
        """Показывает информационное окно рядом с объектом"""
        # Закрываем предыдущее окно, если было открыто
        if self.info_window:
            self.info_window.close()                        # Закрываем старое окно
        
        # Создаем новое окно
        self.info_window = InfoWindow(self.canvas, self, self.x, self.y)
